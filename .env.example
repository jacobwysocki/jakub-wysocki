# Optional public base URL for metadata, robots, sitemap, and structured data.
# This value is shipped publicly; it is not a secret.
# NEXT_PUBLIC_SITE_URL="https://example.com"

# Optional contact phone, returned only after a visitor clicks "Show number".
# Leave unset to hide the phone option across the whole site.
# CONTACT_PHONE="+48 000 000 000"

# Ask Jakub stays provider-disabled unless both values below are present.
# GROQ_API_KEY is server-only: never prefix it with NEXT_PUBLIC_.
# Run ./scripts/setup-groq.sh for the guided free-tier setup.
# ASK_JAKUB_PROVIDER="groq"
# GROQ_API_KEY=""
